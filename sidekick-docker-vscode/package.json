{
  "name": "sidekick-docker-vscode",
  "displayName": "Sidekick Docker",
  "description": "Docker management dashboard for VS Code",
  "version": "0.2.6",
  "publisher": "CesarAndresLopez",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "author": "Cesar Andres Lopez <cesarandreslopez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesarandreslopez/sidekick-docker.git",
    "directory": "sidekick-docker-vscode"
  },
  "homepage": "https://cesarandreslopez.github.io/sidekick-docker/",
  "bugs": {
    "url": "https://github.com/cesarandreslopez/sidekick-docker/issues"
  },
  "keywords": [
    "docker",
    "docker-compose",
    "containers",
    "dashboard",
    "devops",
    "docker-management",
    "vscode"
  ],
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "icon": "images/icon-128.png",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sidekick-docker",
          "title": "Sidekick Docker",
          "icon": "images/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "sidekick-docker": [
        {
          "id": "sidekick-docker.containers",
          "name": "Containers"
        }
      ]
    },
    "commands": [
      {
        "command": "sidekick-docker.openDashboard",
        "title": "Sidekick Docker: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "sidekick-docker.refreshContainers",
        "title": "Sidekick Docker: Refresh Containers",
        "icon": "$(refresh)"
      },
      {
        "command": "sidekick-docker.startContainer",
        "title": "Start",
        "icon": "$(debug-start)"
      },
      {
        "command": "sidekick-docker.stopContainer",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sidekick-docker.openContainerInDashboard",
        "title": "Open in Dashboard"
      },
      {
        "command": "sidekick-docker.quickStart",
        "title": "Sidekick Docker: Start Container..."
      },
      {
        "command": "sidekick-docker.quickStop",
        "title": "Sidekick Docker: Stop Container..."
      },
      {
        "command": "sidekick-docker.quickRestart",
        "title": "Sidekick Docker: Restart Container..."
      }
    ],
    "viewsWelcome": [
      {
        "view": "sidekick-docker.containers",
        "contents": "No containers found.\n[Open Dashboard](command:sidekick-docker.openDashboard)"
      }
    ],
    "configuration": {
      "title": "Sidekick Docker",
      "properties": {
        "sidekick-docker.socketPath": {
          "type": "string",
          "default": "",
          "description": "Docker endpoint: a socket path (e.g. /var/run/docker.sock), unix://, or tcp://host:port. Leave empty to use the platform default socket (or the DOCKER_HOST environment variable if set)."
        },
        "sidekick-docker.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Seconds between fallback full refreshes of Docker state (events still update instantly)."
        },
        "sidekick-docker.statusBar.visible": {
          "type": "boolean",
          "default": true,
          "description": "Show the Sidekick Docker container count in the status bar."
        },
        "sidekick-docker.exec.defaultShell": {
          "type": "string",
          "default": "/bin/sh",
          "description": "Shell to launch when opening an exec terminal into a container."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "sidekick-docker.refreshContainers",
          "when": "view == sidekick-docker.containers",
          "group": "navigation@1"
        },
        {
          "command": "sidekick-docker.openDashboard",
          "when": "view == sidekick-docker.containers",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sidekick-docker.startContainer",
          "when": "view == sidekick-docker.containers && viewItem =~ /^container-(exited|created|dead)$/",
          "group": "inline@1"
        },
        {
          "command": "sidekick-docker.stopContainer",
          "when": "view == sidekick-docker.containers && viewItem == container-running",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.cjs",
    "watch": "node esbuild.cjs --watch",
    "clean": "rm -rf out",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "sidekick-docker-shared": "file:../sidekick-docker-shared",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.3.6"
  },
  "license": "MIT"
}
