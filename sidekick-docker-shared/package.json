{
  "name": "sidekick-docker-shared",
  "version": "0.2.6",
  "description": "Shared Docker API layer, types, and compose detection",
  "author": "Cesar Andres Lopez <cesarandreslopez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesarandreslopez/sidekick-docker.git",
    "directory": "sidekick-docker-shared"
  },
  "homepage": "https://cesarandreslopez.github.io/sidekick-docker/",
  "bugs": {
    "url": "https://github.com/cesarandreslopez/sidekick-docker/issues"
  },
  "keywords": [
    "docker",
    "docker-api",
    "docker-compose",
    "dockerode",
    "typescript",
    "containers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/"
  ],
  "icon": "images/icon-128.png",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./log": "./dist/log/index.js",
    "./formatters": "./dist/formatters.js"
  },
  "typesVersions": {
    "*": {
      "log": [
        "dist/log/index.d.ts"
      ],
      "formatters": [
        "dist/formatters.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dockerode": "^4.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
